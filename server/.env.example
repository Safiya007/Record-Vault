PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/recordvault
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Email Alerts (Gmail SMTP via Nodemailer)
# EMAIL_USER: the Gmail address alerts will be sent FROM
# EMAIL_APP_PASSWORD: a 16-character Gmail "App Password" (NOT your normal password)
#   Generate at: https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification to be enabled on the Google account)
EMAIL_USER=youraddress@gmail.com
EMAIL_APP_PASSWORD=your16charapppassword
EMAIL_ALERTS_ENABLED=true

# Email Import (IMAP - reuses EMAIL_USER / EMAIL_APP_PASSWORD above)
# Requires IMAP to be enabled in Gmail: Settings -> Forwarding and POP/IMAP -> Enable IMAP.
# The same App Password used for sending alerts works for this too.
